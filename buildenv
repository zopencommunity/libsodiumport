# bump: libsodium-version /LIBSODIUM_VERSION="(.*)"/ https://github.com/jedisct1/libsodium.git|semver:*
LIBSODIUM_VERSION="1.0.20"

###
### Build control file for the libsodium port
###
### libsodium is a C crypto library. It is wanted here mainly because PyNaCl
### needs it, and PyNaCl in turn is what blocks paramiko (SSH) and pygithub.
### PyNaCl vendors its own copy, but building that copy in-place gives every
### consumer its own libsodium; a port lets PyNaCl link a single shared one
### with SODIUM_INSTALL=system.
###
### One patch is required -- see patches/README.md. It is in the random number
### generator, so read that file before relying on this port.
###

export ZOPEN_PROJECT_NAME="libsodium"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="library security"

# GIT rather than the release tarball: applyPatches needs a git-managed source
# tree and skips patching entirely without one, which here would silently
# produce a library whose RNG does not compile.
export ZOPEN_STABLE_URL="https://github.com/jedisct1/libsodium.git"
export ZOPEN_STABLE_TAG="${LIBSODIUM_VERSION}-RELEASE"
export ZOPEN_DEV_URL="https://github.com/jedisct1/libsodium.git"

# make must be GNU make. z/OS make rejects -j and cannot handle the pattern
# rules in libsodium's generated Makefiles, failing with
# "FSUM9435 Empty recipe for special target %".
export ZOPEN_STABLE_DEPS="make coreutils diffutils findutils sed grep bash zoslib"
export ZOPEN_DEV_DEPS="make coreutils diffutils findutils sed grep bash zoslib"
export ZOPEN_RUNTIME_DEPS="zoslib"

# --disable-asm turns off libsodium's hand-written assembly and CPU-feature
# libraries. On z/OS that is not an optimisation choice, it is required:
# configure decides AES-NI is available because the *compiler* accepts the
# intrinsics, without regard to whether the *target* has the instructions --
# and AES-NI is x86. The build then fails in libtool with
#
#   cannot build libtool library 'libaesni.la' from non-libtool objects
#
# which points at libtool rather than at an x86 acceleration library being
# built for a mainframe.
# ac_cv_func_posix_memalign=no is not a claim that the function is missing --
# it is in libc, and configure's link test finds it. The compile of
# argon2-core.c nonetheless fails with "call to undeclared function
# 'posix_memalign'" even though -D_UNIX03_SOURCE is present in both CPPFLAGS
# and CFLAGS on the real command line, and the same call compiles cleanly in
# isolation under every combination of this build's flags, include order and
# -isystem paths that could be reproduced. What hides the declaration inside
# the full build is unresolved.
#
# Rather than guess, take the branch upstream ships for platforms without it.
# The allocation chain in argon2-core.c is
#
#   #if defined(MAP_ANON) && defined(HAVE_MMAP)   <- MAP_ANON is not defined here
#   #elif defined(HAVE_POSIX_MEMALIGN)            <- the branch that fails
#   #else                                          <- portable malloc + 64-byte align
#
# so telling configure the function is unavailable lands on libsodium's own
# portable path, with their alignment arithmetic rather than anything invented
# here. The cost is a plain malloc per argon2 region instead of an aligned
# allocation. crypto_pwhash is checked below because this is the code path the
# setting moves.
#
# --disable-shared: z/OS libtool cannot build a shared library from these
# objects and stops with
#
#   cannot build libtool library 'libaesni.la' from non-libtool objects on this host
#
# which names AES-NI and so reads as an x86 problem -- it is not, it is about
# the shared build. Consumers here link the static archive anyway: zopen ships
# .a files, and cryptography's extension already links its dependencies
# statically.
#
# lt_cv_deplibs_check_method=pass_all: zopen-build puts two raw object files
# into LIBS -- zoslib's celquopt.s.o and the generated zoslib_env_hook.o -- and
# libtool refuses to build any .la library when LIBS holds non-libtool objects:
#
#   cannot build libtool library 'libaesni.la' from non-libtool objects on this host
#
# It names libaesni only because that is the first .la target reached, which
# makes it read as an x86 problem; it is not, and it would fail on whichever
# convenience library came first. Setting the cache variable makes libtool
# accept them, which is the same effect as the configure patch zopen ports
# usually carry for this, without pinning a patch to line numbers in a
# generated file.
export ZOPEN_EXTRA_CONFIGURE_OPTS="--disable-shared --disable-asm ac_cv_func_posix_memalign=no lt_cv_deplibs_check_method=pass_all lt_cv_sys_max_cmd_len=32768"

zopen_get_version() {
  echo "${LIBSODIUM_VERSION}"
}

# posix_memalign sits behind __SUSV3_RT in <stdlib.h>, which _UNIX03_SOURCE
# turns on. Without it configure still detects the function -- its link test
# passes because the symbol is in libc -- and argon2-core.c then fails with
# "call to undeclared function 'posix_memalign'", pointing at the source rather
# than at a missing feature-test macro.
#
# These are ZOPEN_EXTRA_* rather than exports in a hook. zopen-build composes
#   export CFLAGS="${ZOPEN_CFLAGS} ${ZOPEN_EXTRA_CFLAGS}"
# during dependency setup, so anything a hook exports into CFLAGS directly is
# overwritten before configure runs -- which is exactly what happened on the
# first CI build, where --disable-asm took effect and the macro did not.
export ZOPEN_EXTRA_CPPFLAGS="-D_UNIX03_SOURCE"
export ZOPEN_EXTRA_CFLAGS="-D_UNIX03_SOURCE"

zopen_pre_configure() {
  # Force /bin/sh as the shell recorded in the generated Makefiles.
  #
  # The zopen bash changes directory to /jenkins when it starts, so any make
  # recipe that runs through it begins in the wrong place. libsodium recurses
  # into subdirectories, so the first recursion fails with
  #
  #   bash: line 21: cd: builds: EDC5129I No such file or directory.
  #
  # which reads as a missing source directory rather than a shell that moved.
  # configure bakes SHELL into every Makefile, so setting it here fixes the
  # whole tree at once.
  export SHELL="/bin/sh"
  export CONFIG_SHELL="/bin/sh"
}

# Upstream's "make check" cannot be used here, and the reason is worth stating
# so nobody "fixes" it later. Its tests hash and encode C string literals, then
# compare against .exp files generated from ASCII inputs. On z/OS a literal is
# EBCDIC, so the inputs genuinely differ and the outputs differ with them --
# sha256 of EBCDIC "abc" is b58ea6d3..., not ba7816bf.... The harness compares
# byte-for-byte and exits 99 with no output, which looks like a crash. Running
# it here reports 5 failures and 31 errors against a library that is computing
# everything correctly.
#
# So check known answers with inputs written as explicit bytes, where EBCDIC
# cannot intrude, plus a concurrency test for the RNG patch.
export ZOPEN_CHECK="zopen_custom_check"

zopen_custom_check() {
  cat > kat.c <<'KATEOF'
#include <pthread.h>
#include <stdio.h>
#include <string.h>
#include "sodium.h"

#define THREADS 8
#define DRAWS   500
#define BLOCK   16
static unsigned char results[THREADS][DRAWS][BLOCK];

static void *worker(void *arg) {
    long id = (long) arg; int i;
    for (i = 0; i < DRAWS; i++) randombytes_buf(results[id][i], BLOCK);
    return NULL;
}
static int cmp(const void *a, const void *b) { return memcmp(a, b, BLOCK); }

static int fails = 0;
static void check(const char *label, int ok) {
    printf(ok ? "PASS: %s\n" : "FAIL: %s\n", label);
    if (!ok) fails++;
}
static int hexeq(const unsigned char *b, size_t n, const char *want) {
    char got[256]; size_t i;
    for (i = 0; i < n; i++) sprintf(got + i * 2, "%02x", b[i]);
    return strcmp(got, want) == 0;
}

int main(void) {
    check("sodium_init", sodium_init() == 0);

    /* SHA-256 of the bytes 0x61 0x62 0x63 -- "abc" written explicitly, because
     * the literal "abc" is EBCDIC on this platform. */
    const unsigned char abc[3] = { 0x61, 0x62, 0x63 };
    unsigned char h[crypto_hash_sha256_BYTES];
    crypto_hash_sha256(h, abc, sizeof abc);
    check("sha256 known answer",
          hexeq(h, sizeof h,
                "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));

    /* RFC 7539 ChaCha20, all-zero key and nonce. */
    unsigned char key[32], nonce[8], out[32];
    memset(key, 0, sizeof key); memset(nonce, 0, sizeof nonce);
    crypto_stream_chacha20(out, sizeof out, nonce, key);
    check("chacha20 known answer",
          hexeq(out, sizeof out,
                "76b8e0ada0f13d90405d6ae55386bd28bdd219b8a08ded1aa836efcc8b770dc7"));

    /* Ed25519 round trip. */
    unsigned char pk[crypto_sign_PUBLICKEYBYTES], sk[crypto_sign_SECRETKEYBYTES];
    unsigned char sig[crypto_sign_BYTES];
    unsigned long long siglen;
    const unsigned char msg[4] = { 0xde, 0xad, 0xbe, 0xef };
    crypto_sign_keypair(pk, sk);
    crypto_sign_detached(sig, &siglen, msg, sizeof msg, sk);
    check("ed25519 sign/verify",
          crypto_sign_verify_detached(sig, msg, sizeof msg, pk) == 0);
    sig[0] ^= 0x01;
    check("ed25519 rejects a tampered signature",
          crypto_sign_verify_detached(sig, msg, sizeof msg, pk) != 0);

    /* secretbox round trip. */
    unsigned char sbk[crypto_secretbox_KEYBYTES], sbn[crypto_secretbox_NONCEBYTES];
    unsigned char ct[crypto_secretbox_MACBYTES + 4], pt[4];
    crypto_secretbox_keygen(sbk); randombytes_buf(sbn, sizeof sbn);
    crypto_secretbox_easy(ct, msg, sizeof msg, sbn, sbk);
    check("secretbox round trip",
          crypto_secretbox_open_easy(pt, ct, sizeof ct, sbn, sbk) == 0 &&
          memcmp(pt, msg, sizeof msg) == 0);

    /* The RNG state is thread-local through a pthread key on this platform
     * (see patches/). Concurrent draws must not share or race it. */
    pthread_t t[THREADS]; long i, j; int round;
    for (round = 0; round < 2; round++) {
        for (i = 0; i < THREADS; i++) pthread_create(&t[i], NULL, worker, (void *) i);
        for (i = 0; i < THREADS; i++) pthread_join(t[i], NULL);
    }
    long total = (long) THREADS * DRAWS, zeros = 0, dups = 0;
    unsigned char zero[BLOCK]; memset(zero, 0, BLOCK);
    static unsigned char flat[THREADS * DRAWS][BLOCK];
    long n = 0;
    for (i = 0; i < THREADS; i++)
        for (j = 0; j < DRAWS; j++) {
            if (memcmp(results[i][j], zero, BLOCK) == 0) zeros++;
            memcpy(flat[n++], results[i][j], BLOCK);
        }
    qsort(flat, (size_t) total, BLOCK, cmp);
    for (j = 1; j < total; j++)
        if (memcmp(flat[j - 1], flat[j], BLOCK) == 0) dups++;
    check("rng produces output on every thread", zeros == 0);
    check("rng streams do not collide across threads", dups == 0);

    /* crypto_pwhash is argon2, whose allocator this port moves off
     * posix_memalign onto libsodium's portable fallback, so exercise it. */
    unsigned char pwkey[32], pwkey2[32];
    unsigned char salt[crypto_pwhash_SALTBYTES];
    const char pw[4] = { 0x70, 0x77, 0x64, 0x00 };  /* "pwd"; literals are EBCDIC here */
    memset(salt, 0x42, sizeof salt);
    check("argon2 derives a key",
          crypto_pwhash(pwkey, sizeof pwkey, pw, 3, salt,
                        crypto_pwhash_OPSLIMIT_INTERACTIVE,
                        crypto_pwhash_MEMLIMIT_INTERACTIVE,
                        crypto_pwhash_ALG_DEFAULT) == 0);
    check("argon2 is deterministic for the same inputs",
          crypto_pwhash(pwkey2, sizeof pwkey2, pw, 3, salt,
                        crypto_pwhash_OPSLIMIT_INTERACTIVE,
                        crypto_pwhash_MEMLIMIT_INTERACTIVE,
                        crypto_pwhash_ALG_DEFAULT) == 0
          && memcmp(pwkey, pwkey2, sizeof pwkey) == 0);
    salt[0] ^= 0xFF;
    check("argon2 output changes with the salt",
          crypto_pwhash(pwkey2, sizeof pwkey2, pw, 3, salt,
                        crypto_pwhash_OPSLIMIT_INTERACTIVE,
                        crypto_pwhash_MEMLIMIT_INTERACTIVE,
                        crypto_pwhash_ALG_DEFAULT) == 0
          && memcmp(pwkey, pwkey2, sizeof pwkey) != 0);

    printf("libsodium KAT -- %d failed\n", fails);
    return fails == 0 ? 0 : 1;
}
KATEOF
  # libsodium.a alone does not link here: the objects were compiled against
  # zoslib, so __open_ascii and __close come out UNRESOLVED (IEW2456E) and the
  # binder ends with RC 12 -- which reads as a broken library rather than a
  # short link line. Take LIBS and LDFLAGS from the Makefile that configure
  # generated so the KAT links exactly the way the library was built, instead of
  # restating the zoslib paths here where they would drift.
  _mkf="${ZOPEN_ROOT}/${sourcedir}/src/libsodium/Makefile"
  _plibs=$(grep -E "^LIBS =" "${_mkf}" 2> /dev/null | head -1 | sed "s/^LIBS = *//")
  _pldf=$(grep -E "^LDFLAGS =" "${_mkf}" 2> /dev/null | head -1 | sed "s/^LDFLAGS = *//")
  # CFLAGS matters for more than optimisation here: it carries
  # -fzos-le-char-mode=ascii. Without it the KAT's string literals are EBCDIC,
  # so its PASS:/FAIL: lines land in the log in a character set that
  # zopen_check_results cannot grep, and the run is scored as zero tests even
  # though every assertion passed.
  _pcfl=$(grep -E "^CFLAGS =" "${_mkf}" 2> /dev/null | head -1 | sed "s/^CFLAGS = *//")
  # _OPEN_THREADS is required for pthread_t to be declared at all on z/OS.
  "${CC:-clang}" -D_OPEN_THREADS=3 ${_pcfl} \
    -I"${ZOPEN_ROOT}/${sourcedir}/src/libsodium/include" \
    -I"${ZOPEN_ROOT}/${sourcedir}/src/libsodium/include/sodium" \
    ${_pldf} \
    -o kat kat.c "${ZOPEN_ROOT}/${sourcedir}/src/libsodium/.libs/libsodium.a" \
    ${_plibs} || return 1
  ./kat
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="${dir}/${pfx}_check.log"
  # No "|| echo 0": grep -c prints 0 and also exits 1, so a fallback appends a
  # second zero and the arithmetic dies with FSUM9224 "bad number".
  passed=$(grep -c "^PASS:" "${chk}" 2>/dev/null)
  failed=$(grep -c "^FAIL:" "${chk}" 2>/dev/null)
  passed=${passed:-0}
  failed=${failed:-0}
  echo "actualFailures:${failed}"
  echo "totalTests:$((passed + failed))"
  echo "expectedFailures:0"
}

zopen_append_to_validate_install() {
  echo "test -f \${PWD}/lib/libsodium.a"
}

# libsodium always builds nine SIMD convenience libraries -- libaesni,
# libarmcrypto, libsse2, libssse3, libsse41, libavx2, libavx512f and friends --
# and links them into libsodium via libsodium_la_LIBADD. There is no configure
# switch to suppress them; --disable-asm does not.
#
# On z/OS libtool cannot merge them. It extracts each convenience archive into
# .libs/libsodium.lax/ and then emits archive commands that arrive with an
# empty command word, so the shell tries to execute the object file itself:
#
#   .libs/libsodium.lax/libaesni.a/libaesni_la-aegis128l_aesni.o: ...
#   FSUM9209 cannot execute: reason code = ef076015: EDC5111I Permission denied.
#
# The message names libaesni only because it is extracted first, which makes it
# read as an AES-NI or x86 problem; it is neither, and it is not the command
# length either (lowering libtool's max_cmd_len only changes how many objects
# are reported).
#
# Every one of these archives is x86 or ARM. Their sources compile to
# implementation tables guarded by HAVE_AESNIINTRIN_H and friends, none of which
# are defined here, so nothing in the build references them -- verified by
# linking sign/verify, BLAKE2b and randombytes against the resulting library
# with the archives dropped. Removing them from LIBADD costs nothing on z/OS and
# is what lets the link complete.
#
# Matched on the assignment rather than by line number: LIBADD spans
# continuation lines, and the generated Makefile shifts between releases.
zopen_pre_build() {
  _mf="src/libsodium/Makefile"
  [ -f "${_mf}" ] || return 0
  _tag=$(ls -T "${_mf}" 2> /dev/null | awk '{print $2}')
  awk '
    /^libsodium_la_LIBADD =/ {
      print "libsodium_la_LIBADD ="
      if ($0 ~ /\\$/) { skip = 1 }
      next
    }
    skip == 1 { if ($0 !~ /\\$/) { skip = 0 } ; next }
    { print }
  ' "${_mf}" > "${_mf}.zos" && mv "${_mf}.zos" "${_mf}"
  [ -n "${_tag}" ] && chtag -tc "${_tag}" "${_mf}" 2> /dev/null
  return 0
}
